# Local SQLite database file used in development.
# Points at a file relative to the project root — the "file:" prefix
# matches Prisma-style DATABASE_URL conventions for familiarity.
DATABASE_URL="file:./db/dev.db"

# Optional. Where uploaded vehicle photos are stored on disk.
# Defaults to ./storage/vehicle-photos when unset — only needed if you
# want uploads to live somewhere else.
# VEHICLE_PHOTO_STORAGE_DIR="./storage/vehicle-photos"

# Mission 033 — Atlas Assistant.

# Required for the assistant to be available at all (website chat and
# WhatsApp). Without this, the assistant is honestly reported as
# "not configured" — nothing pretends to be AI.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional. Defaults to claude-sonnet-5. claude-haiku-4-5-20251001 is a
# cheaper/faster option.
# ASSISTANT_MODEL="claude-sonnet-5"

# Optional. Used by the WhatsApp webhook to construct product photo
# links (WhatsApp needs an absolute, publicly reachable URL). Without
# it, the assistant still replies with text on WhatsApp, just without
# product photos.
# PUBLIC_BASE_URL="https://your-deployment.example.com"

# --- WhatsApp Business Cloud API (official API only) ---
# All four are required for real WhatsApp; the demo simulator at
# /app/assistant/demo needs none of them.

# Set by you, checked against Meta's webhook verification handshake
# (GET /api/whatsapp/webhook).
# WHATSAPP_VERIFY_TOKEN="choose-a-random-string"

# From your Meta app's dashboard — used to verify the
# X-Hub-Signature-256 header on every inbound webhook POST.
# META_APP_SECRET="..."

# From your Meta app's dashboard.
# META_APP_ID="..."

# The WhatsApp Business phone number's id (not the phone number
# itself). Also enter this in Settings > Assistant > WhatsApp for the
# business that number belongs to.
# WHATSAPP_PHONE_NUMBER_ID="..."

# A system-user access token with whatsapp_business_messaging
# permission, used to send replies. (A per-business OAuth-connected
# token, via the existing Marketing > channels flow, is used instead
# when present.)
# WHATSAPP_ACCESS_TOKEN="..."

# --- Mission 037: production deployment (see DEPLOY.md) ---
# All four are REQUIRED when NODE_ENV=production; the server refuses to start without them.

# Your domain, no scheme (comma-separate several). Server Actions reject any other origin.
# ALLOWED_ORIGINS="atlas.example.com"

# PUBLIC_BASE_URL (above) must be an absolute https:// URL in production.

# 32 random bytes, base64: openssl rand -base64 32. Encrypts stored Meta/WhatsApp tokens.
# Losing this key makes stored tokens unrecoverable (reconnect the channels); back it up separately.
# ATLAS_ENCRYPTION_KEY=""

# Optional: daily caps on paid AI calls (fail closed when reached). UTC day.
# AI_DAILY_CAP_GLOBAL=2000        # every outbound Anthropic request
# AI_DAILY_CAP_PER_BUSINESS=500   # operator CEILING on customer messages per business per day.
#   Mission 038: the real per-business allowance comes from the plan (Growth 150, Pro 500, trial 60,
#   Starter none — see entitlements/domain/plan.ts); this can only lower it, never raise it.

# Optional: set to "report-only" to roll out the Content-Security-Policy without enforcing it.
# CSP_MODE="report-only"

# --- Mission 039: Messenger + Instagram DMs ---
# Webhook URL to register in the Meta app: https://<your-domain>/api/meta/webhook
# Verify token you choose for the Messenger/Instagram webhook (falls back to WHATSAPP_VERIFY_TOKEN).
# META_WEBHOOK_VERIFY_TOKEN="choose-a-random-string"
# META_APP_SECRET (above) is also used to verify these webhooks' X-Hub-Signature-256.
# Graph API version for all Meta calls. Meta retires old versions: check the changelog and set a current one.
# META_GRAPH_API_VERSION="v19.0"

# --- Mission 040/041: payments & automated plan billing ---
# Customer payments (M-Pesa prompts from a deal) use each business's OWN Daraja credentials, stored encrypted via the
# Settings page; they need PUBLIC_BASE_URL (https) and ATLAS_ENCRYPTION_KEY above. Optional safety knobs:
# PAYMENTS_ENABLED=true                     # false = global kill switch for M-Pesa prompts and callbacks
# MPESA_MAX_STK_AMOUNT=250000               # largest single M-Pesa prompt (KES)
# MPESA_STK_HOURLY_VOLUME_CAP_KES=1000000   # most a business can request by prompt per hour

# Atlas's OWN plan billing (where businesses pay Atlas). ALL SEVEN must be set together or the server refuses to start.
# MPESA_PLATFORM_ENV=sandbox                # sandbox | production
# MPESA_PLATFORM_TYPE=paybill               # paybill | till
# MPESA_PLATFORM_SHORTCODE=
# MPESA_PLATFORM_TILL=                      # only if different from the shortcode (buy-goods)
# MPESA_PLATFORM_CONSUMER_KEY=
# MPESA_PLATFORM_CONSUMER_SECRET=
# MPESA_PLATFORM_PASSKEY=
# BILLING_CALLBACK_TOKEN=                   # openssl rand -hex 24  (48 hex chars; part of the callback URL path)
# BILLING_CRON_SECRET=                      # openssl rand -hex 32  (guards POST /api/billing/cron)
# BILLING_ENABLED=true                      # false = kill switch for the whole billing engine
