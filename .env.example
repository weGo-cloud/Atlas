# Local SQLite database file used in development.
# Points at a file relative to the project root — the "file:" prefix
# matches Prisma-style DATABASE_URL conventions for familiarity.
DATABASE_URL="file:./db/dev.db"

# Optional. Where uploaded vehicle photos are stored on disk.
# Defaults to ./storage/vehicle-photos when unset — only needed if you
# want uploads to live somewhere else.
# VEHICLE_PHOTO_STORAGE_DIR="./storage/vehicle-photos"

# Mission 033 — Atlas Assistant.

# Required for the assistant to be available at all (website chat and
# WhatsApp). Without this, the assistant is honestly reported as
# "not configured" — nothing pretends to be AI.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional. Defaults to claude-sonnet-5. claude-haiku-4-5-20251001 is a
# cheaper/faster option.
# ASSISTANT_MODEL="claude-sonnet-5"

# Optional. Used by the WhatsApp webhook to construct product photo
# links (WhatsApp needs an absolute, publicly reachable URL). Without
# it, the assistant still replies with text on WhatsApp, just without
# product photos.
# PUBLIC_BASE_URL="https://your-deployment.example.com"

# --- WhatsApp Business Cloud API (official API only) ---
# All four are required for real WhatsApp; the demo simulator at
# /app/assistant/demo needs none of them.

# Set by you, checked against Meta's webhook verification handshake
# (GET /api/whatsapp/webhook).
# WHATSAPP_VERIFY_TOKEN="choose-a-random-string"

# From your Meta app's dashboard — used to verify the
# X-Hub-Signature-256 header on every inbound webhook POST.
# META_APP_SECRET="..."

# From your Meta app's dashboard.
# META_APP_ID="..."

# The WhatsApp Business phone number's id (not the phone number
# itself). Also enter this in Settings > Assistant > WhatsApp for the
# business that number belongs to.
# WHATSAPP_PHONE_NUMBER_ID="..."

# A system-user access token with whatsapp_business_messaging
# permission, used to send replies. (A per-business OAuth-connected
# token, via the existing Marketing > channels flow, is used instead
# when present.)
# WHATSAPP_ACCESS_TOKEN="..."
